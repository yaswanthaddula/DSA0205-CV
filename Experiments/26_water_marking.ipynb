      "source": [
        "import cv2\n",
        "from google.colab.patches import cv2_imshow\n",
        "img = cv2.imread(\"/content/images.jpg\")\n",
        "\n",
        "cv2.putText(img, \"WATERMARK\", (10, img.shape[0] - 20),\n",
        "            cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0,0,255), 2)\n",
        "\n",
        "cv2_imshow(img)\n",
        "\n",
        "cv2.imwrite(\"/content/output.jpg\", img)"
      ],
