      "source": [
        "import cv2\n",
        "from google.colab.patches import cv2_imshow\n",
        "img = cv2.imread(\"/content/images.jpg\")\n",
        "crop = img[50:150, 50:150]\n",
        "h, w = img.shape[:2]\n",
        "img[h-120:h-20, w-120:w-20] = crop\n",
        "cv2_imshow(img)"
      ],
