      "source": [
        "import cv2\n",
        "import numpy as np\n",
        "from google.colab.patches import cv2_imshow\n",
        "\n",
        "# Read image\n",
        "img = cv2.imread(\"/content/images.jpg\", 0)\n",
        "\n",
        "# Create kernel\n",
        "kernel = np.ones((5,5), np.uint8)\n",
        "\n",
        "# Apply erosion\n",
        "erosion = cv2.erode(img, kernel, iterations=1)\n",
        "\n",
        "# Display result\n",
        "cv2_imshow(erosion)"
      ],
